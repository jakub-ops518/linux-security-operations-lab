log_format ingress_main
  'remote_addr=$remote_addr '
  'time="$time_local" '
  'host="$host" '
  'method=$request_method '
  'uri="$request_uri" '
  'status=$status '
  'bytes=$body_bytes_sent '
  'request_time=$request_time '
  'upstream_addr="$upstream_addr" '
  'upstream_status="$upstream_status" '
  'request_id="$request_id" '
  'user_agent="$http_user_agent"';

upstream app_php_hosting {
    server {{ hostvars[groups['app'][0]].ansible_host }}:8080;
}

upstream tenant_admin_portal {
    server lab-tenant-admin:8080;
}

server {
    listen 80 default_server;
    server_name _;

    access_log /var/log/nginx/access.log ingress_main;
    error_log /var/log/nginx/error.log warn;

    location = /health {
        add_header Content-Type text/plain;
        return 200 "ingress ok\n";
    }

    location = /admin {
        return 301 /admin/;
    }

    location /admin/ {
        proxy_pass http://tenant_admin_portal;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        add_header X-Ingress-Node "{{ inventory_hostname }}" always;
        add_header X-Request-ID $request_id always;
    }

    location /site-alpha/ {
        proxy_pass http://app_php_hosting;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        add_header X-Ingress-Node "{{ inventory_hostname }}" always;
        add_header X-Request-ID $request_id always;
    }

    location /site-beta/ {
        proxy_pass http://app_php_hosting;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        add_header X-Ingress-Node "{{ inventory_hostname }}" always;
        add_header X-Request-ID $request_id always;
    }

    location / {
        add_header Content-Type text/plain;
        return 200 "Dedicated ingress layer. Available paths: /site-alpha/, /site-beta/, and /admin/\n";
    }
}

include /etc/nginx/dynamic/*.conf;
