global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alert.rules.yml

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets:
          - "prometheus:9090"

  - job_name: "node_exporter"
    static_configs:
      - targets:
          - "{{ hostvars[groups['app'][0]].ansible_host }}:9100"
        labels:
          monitored_node: "{{ groups['app'][0] }}"
