#!/usr/bin/env python3
import json
import os
import re
import subprocess
import sys
import tempfile

TENANTS_FILE = "/opt/lab-tenant-admin/config/tenants.json"
REGISTRY_FILE = "/opt/lab-tenant-admin/data/tenant-domains.json"
OUTPUT_FILE = "/opt/lab-ingress/dynamic/tenant-domains.conf"

DOMAIN_RE = re.compile(
    r"^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$"
)

def load_json(path, default):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return default

def valid_domain(domain):
    domain = domain.strip().lower().rstrip(".")
    return domain if DOMAIN_RE.match(domain) else ""

def render_server(domain, site_name, site_path):
    return f"""
server {{
    listen 80;
    server_name {domain};

    access_log /var/log/nginx/access.log ingress_main;
    error_log /var/log/nginx/error.log warn;

    location = /health {{
        add_header Content-Type text/plain;
        return 200 "ingress ok\\n";
    }}

    location / {{
        proxy_pass http://app_php_hosting{site_path};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        add_header X-Ingress-Node "vm-ingress-01" always;
        add_header X-Lab-Tenant "{site_name}" always;
        add_header X-Request-ID $request_id always;
    }}
}}
"""

def write_atomic(path, content):
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".tenant-domains-", dir=directory, text=True)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(content)
    os.replace(tmp, path)

def reload_nginx():
    result = subprocess.run(
        ["docker", "ps", "--filter", "name=^/lab-ingress-nginx$", "--filter", "status=running", "--quiet"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=False,
    )
    if not result.stdout.strip():
        return

    subprocess.run(["docker", "exec", "lab-ingress-nginx", "nginx", "-t"], check=True)
    subprocess.run(["docker", "exec", "lab-ingress-nginx", "nginx", "-s", "reload"], check=True)

def main():
    tenants = load_json(TENANTS_FILE, {})
    registry = load_json(REGISTRY_FILE, {})

    parts = [
        "# This file is generated by lab-render-tenant-domains.",
        "# Do not edit manually.",
        ""
    ]

    used_domains = set()

    for site_name, entry in sorted(registry.items()):
        if site_name not in tenants:
            continue

        domain = valid_domain(entry.get("domain", ""))
        if not domain:
            continue

        if domain in used_domains:
            print(f"duplicate domain skipped: {domain}", file=sys.stderr)
            continue

        site_path = tenants[site_name]["site_path"]
        used_domains.add(domain)
        parts.append(render_server(domain, site_name, site_path))

    write_atomic(OUTPUT_FILE, "\n".join(parts) + "\n")
    reload_nginx()

if __name__ == "__main__":
    main()
