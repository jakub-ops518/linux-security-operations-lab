services:
  multisite-nginx:
    image: nginx:stable
    container_name: lab-multisite-nginx
    restart: unless-stopped
    depends_on:
      - site-alpha-php-01
      - site-alpha-php-02
      - site-beta-php-01
      - site-beta-php-02
    ports:
      - "8080:80"
    volumes:
      - /srv/www/_proxy/default.conf:/etc/nginx/conf.d/default.conf:ro
      - /srv/www/site-alpha/logs:/var/log/nginx/site-alpha
      - /srv/www/site-beta/logs:/var/log/nginx/site-beta
    networks:
      - multisite_web

  site-alpha-php-01:
    image: php:8.3-apache
    container_name: lab-site-alpha-php-01
    restart: unless-stopped
    environment:
      - SITE_ID=site-alpha
      - APP_INSTANCE=site-alpha-php-01
    volumes:
      - /srv/www/site-alpha/public:/var/www/html:ro
    networks:
      multisite_web:
        aliases:
          - site-alpha-php-01

  site-alpha-php-02:
    image: php:8.3-apache
    container_name: lab-site-alpha-php-02
    restart: unless-stopped
    environment:
      - SITE_ID=site-alpha
      - APP_INSTANCE=site-alpha-php-02
    volumes:
      - /srv/www/site-alpha/public:/var/www/html:ro
    networks:
      multisite_web:
        aliases:
          - site-alpha-php-02

  site-beta-php-01:
    image: php:8.3-apache
    container_name: lab-site-beta-php-01
    restart: unless-stopped
    environment:
      - SITE_ID=site-beta
      - APP_INSTANCE=site-beta-php-01
    volumes:
      - /srv/www/site-beta/public:/var/www/html:ro
    networks:
      multisite_web:
        aliases:
          - site-beta-php-01

  site-beta-php-02:
    image: php:8.3-apache
    container_name: lab-site-beta-php-02
    restart: unless-stopped
    environment:
      - SITE_ID=site-beta
      - APP_INSTANCE=site-beta-php-02
    volumes:
      - /srv/www/site-beta/public:/var/www/html:ro
    networks:
      multisite_web:
        aliases:
          - site-beta-php-02

networks:
  multisite_web:
    driver: bridge
